 * 소분류에서 n번째 영상을 골라 실제 한 차시 흐름(명상 → 준비운동 → 본운동 → 정리)으로 엮는다.
 */
function seedSchedules_() {
  function pick(subId, idx) {
    const list = VIDEO_DATA.filter(function (v) { return v[2] === subId; });
    return list.length ? list[Math.min(idx || 0, list.length - 1)][0] : '';
  }
  function seq() {
    return Array.prototype.slice.call(arguments).filter(Boolean).join(',');
  }
  replaceAll_(T.SCHEDULES, [
    { '소유자': 'teacher', '그룹명': '1학기 기본과정', '차시': 1,
      '영상ID목록': seq(pick('S13', 0), pick('S31', 0), pick('S41', 0), pick('S35', 0)) },
    { '소유자': 'teacher', '그룹명': '1학기 기본과정', '차시': 2,
      '영상ID목록': seq(pick('S13', 1), pick('S31', 1), pick('S42', 0), pick('S35', 1)) },
    { '소유자': 'teacher', '그룹명': '리듬 점핑반', '차시': 1,
      '영상ID목록': seq(pick('S21', 0), pick('S45', 0), pick('S53', 0)) },
    { '소유자': 'test', '그룹명': '체력왕 도전', '차시': 1,
      '영상ID목록': seq(pick('S31', 2), pick('S32', 0), pick('S33', 0), pick('S35', 2)) },
    { '소유자': 'test', '그룹명': '체력왕 도전', '차시': 2,
      '영상ID목록': seq(pick('S36', 0), pick('S34', 0), pick('S62', 0)) }
