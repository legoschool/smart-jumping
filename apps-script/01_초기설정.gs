      '권차': i,
      '제목': '스마트점핑 ' + ('0' + i).slice(-2) + '권',
      '표지URL': '',
      '뷰어링크': '',
      '뱃지': i === 1 ? '특호' : ''
    });
  }
  replaceAll_(T.TEXTBOOKS, rows);
}
