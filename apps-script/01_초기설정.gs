    return {
      '영상ID': v[0], '대분류ID': v[1], '소분류ID': v[2], '제목': v[3],
      'youtube_id': v[4], '재생시간': v[5], '조회수': v[6],
      '등록일': today_(), '노출여부': 'Y'
    };
  });
  replaceAll_(T.VIDEOS, rows);
  Logger.log('영상 ' + rows.length + '건 생성 (전부 실제 유튜브 영상)');
}

