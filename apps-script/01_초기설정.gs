function seedCategories_() {
  const rows = [];
  CAT_TREE.forEach(function (c) {
    c[3].forEach(function (s) {
      rows.push({
        '대분류ID': c[0], '대분류명': c[1], '대분류순서': c[2],
        '소분류ID': s[0], '소분류명': s[1], '소분류순서': s[2], 'N뱃지': s[3]
      });
    });
  });
  replaceAll_(T.CATEGORIES, rows);
}

